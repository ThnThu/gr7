%%{init: {"htmlLabels": false}}%%
flowchart LR
    subgraph DET["Đánh giá Detection"]
        direction LR
        D1["Test images +<br/>ground-truth boxes"]:::gray --> D2["YOLOv8s (chính)"]:::blue
        D1 --> DB["Baseline<br/>B-D1 YOLOv8n · B-D2 Faster R-CNN"]:::note
        D2 --> D3["Cùng bộ đánh giá mAP"]:::blue
        DB --> D3
        D3 --> D4["Precision · Recall<br/>mAP@0.5 · mAP@0.5:0.95"]:::blue
    end

    subgraph SEG["Đánh giá Segmentation"]
        direction LR
        S1["Test images +<br/>ground-truth masks"]:::gray --> S2["U-Net (chính)"]:::teal
        S1 --> SB["Baseline<br/>B-S1 Otsu · B-S2 U-Net pretrained"]:::note
        S2 --> S3["Mask Comparison"]:::teal
        SB --> S3
        S3 --> S4["IoU · Dice · mIoU<br/>IoU/Dice nhị phân"]:::teal
    end

    subgraph APP["Đánh giá tầng ứng dụng"]
        direction LR
        A1["20–30 ảnh demo<br/>5–10 câu hỏi mẫu"]:::gray --> A2["LLM/prompt<br/>Captioning / VQA"]:::purple
        A2 --> A3["Đối chiếu JSON<br/>hallucination · độ trễ"]:::purple
    end

    D4 --> R["Evaluation Report<br/>bảng so với baseline"]:::navy
    S4 --> R
    A3 --> R
    R --> E["Error Analysis"]:::gray
    E --> P["Performance Summary"]:::green
    R -.-> N["Không so trực tiếp<br/>mAP với IoU"]:::note

